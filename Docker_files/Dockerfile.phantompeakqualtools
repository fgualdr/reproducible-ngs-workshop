FROM mambaorg/micromamba:2.3.2

LABEL org.opencontainers.image.title="NGS phantompeakqualtools"
LABEL org.opencontainers.image.description="ChIP-seq strand cross-correlation QC"
LABEL org.opencontainers.image.authors="fgualdr"

USER root

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        bash \
        coreutils \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

USER $MAMBA_USER

# Install phantompeakqualtools and its dependencies
RUN micromamba install -y -n base \
    -c conda-forge \
    -c bioconda \
    --strict-channel-priority \
    phantompeakqualtools=1.2.2 \
    r-base \
    samtools \
    && micromamba clean --all --yes

WORKDIR /work

# Verify installation
RUN run_spp.R -h || test -f /opt/conda/bin/run_spp.R

CMD ["bash"]