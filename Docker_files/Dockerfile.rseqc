FROM docker.io/library/python:3.11-slim-bookworm AS builder

ARG RSEQC_VERSION=5.0.5

RUN apt-get update && apt-get install -y --no-install-recommends build-essential zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
RUN python -m venv /opt/rseqc \
    && /opt/rseqc/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
    && /opt/rseqc/bin/pip install --no-cache-dir "RSeQC==${RSEQC_VERSION}"

FROM docker.io/library/python:3.11-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends bash zlib1g \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /opt/rseqc /opt/rseqc
ENV PATH="/opt/rseqc/bin:${PATH}"
WORKDIR /work
CMD ["/bin/bash"]
