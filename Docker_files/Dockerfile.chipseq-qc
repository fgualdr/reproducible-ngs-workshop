FROM docker.io/rocker/r-ver:4.3.3

ARG PHANTOMPEAK_VERSION=1.2.2
ARG IDR_VERSION=2.0.4.2
ARG SAMTOOLS_VERSION=1.20

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates curl git build-essential python3 python3-venv \
    zlib1g-dev libbz2-dev liblzma-dev libcurl4-openssl-dev libssl-dev libncurses-dev \
    libxml2-dev libboost-all-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://github.com/samtools/samtools/releases/download/${SAMTOOLS_VERSION}/samtools-${SAMTOOLS_VERSION}.tar.bz2" -o /tmp/samtools.tar.bz2 \
    && tar -xjf /tmp/samtools.tar.bz2 -C /tmp \
    && cd "/tmp/samtools-${SAMTOOLS_VERSION}" \
    && ./configure --prefix=/usr/local \
    && make -j"$(nproc)" \
    && make install \
    && rm -rf "/tmp/samtools-${SAMTOOLS_VERSION}" /tmp/samtools.tar.bz2

RUN python3 -m venv /opt/idr \
    && /opt/idr/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
    && /opt/idr/bin/pip install --no-cache-dir "idr==${IDR_VERSION}"
ENV PATH="/opt/idr/bin:${PATH}"

RUN R -q -e 'install.packages(c("snow","snowfall","bitops","caTools","BiocManager"), repos="https://cloud.r-project.org")' \
    && R -q -e 'BiocManager::install("Rsamtools", ask=FALSE, update=FALSE)' \
    && git clone --depth 1 --branch "${PHANTOMPEAK_VERSION}" https://github.com/kundajelab/phantompeakqualtools.git /opt/phantompeakqualtools \
    && R CMD INSTALL /opt/phantompeakqualtools/spp_*.tar.gz \
    && ln -s /opt/phantompeakqualtools/run_spp.R /usr/local/bin/run_spp.R \
    && chmod +x /opt/phantompeakqualtools/run_spp.R

WORKDIR /work
CMD ["/bin/bash"]
