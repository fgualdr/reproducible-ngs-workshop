FROM docker.io/library/eclipse-temurin:17-jre-jammy

ARG TRIMMOMATIC_VERSION=0.41

RUN apt-get update && apt-get install -y --no-install-recommends curl unzip ca-certificates bash \
    && mkdir -p /opt/trimmomatic \
    && curl -fsSL "https://github.com/usadellab/Trimmomatic/releases/download/v${TRIMMOMATIC_VERSION}/Trimmomatic-${TRIMMOMATIC_VERSION}.zip" -o /tmp/trimmomatic.zip \
    && unzip -q /tmp/trimmomatic.zip -d /opt/trimmomatic \
    && mv "/opt/trimmomatic/trimmomatic-${TRIMMOMATIC_VERSION}.jar" /opt/trimmomatic/trimmomatic.jar \
    && printf '%s\n' '#!/usr/bin/env bash' 'exec java -jar /opt/trimmomatic/trimmomatic.jar "$@"' > /usr/local/bin/trimmomatic \
    && chmod 0755 /usr/local/bin/trimmomatic \
    && rm -f /tmp/trimmomatic.zip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
CMD ["/bin/bash"]
