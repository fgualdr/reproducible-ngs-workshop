FROM eclipse-temurin:25-jre

ARG TRIMMOMATIC_VERSION=0.41

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl unzip ca-certificates && \
    mkdir -p /opt/trimmomatic && \
    curl -fsSL \
      "https://github.com/usadellab/Trimmomatic/releases/download/v${TRIMMOMATIC_VERSION}/Trimmomatic-${TRIMMOMATIC_VERSION}.zip" \
      -o /tmp/trimmomatic.zip && \
    unzip /tmp/trimmomatic.zip -d /opt/trimmomatic && \
    mv "/opt/trimmomatic/trimmomatic-${TRIMMOMATIC_VERSION}.jar" \
       /opt/trimmomatic/trimmomatic.jar && \
    rm /tmp/trimmomatic.zip && \
    rm -rf /var/lib/apt/lists/*

RUN printf '%s\n' \
    '#!/usr/bin/env bash' \
    'exec java -jar /opt/trimmomatic/trimmomatic.jar "$@"' \
    > /usr/local/bin/trimmomatic && \
    chmod +x /usr/local/bin/trimmomatic

WORKDIR /work

CMD ["/bin/bash"]