FROM docker.io/ncbi/sra-tools:3.4.1

USER root

RUN if command -v apk >/dev/null 2>&1; then \
      apk add --no-cache bash ca-certificates curl pigz; \
    elif command -v apt-get >/dev/null 2>&1; then \
      apt-get update && apt-get install -y --no-install-recommends bash ca-certificates curl pigz \
      && rm -rf /var/lib/apt/lists/*; \
    else \
      echo "Unsupported package manager in ncbi/sra-tools base image" >&2; exit 1; \
    fi

WORKDIR /work
CMD ["/bin/bash"]
